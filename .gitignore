# WhyStuck local state — NEVER commit captured traces/variants (may contain
# session data even after redaction). Default store is outside the repo, but if
# a user opts into a repo-local store this keeps it out of git.
.whystuck/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/

# mkdocs build output
site/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store
scratchpad/

# LaTeX build artifacts. The paper sources are docs/papers/*/main.tex; everything the
# toolchain derives from them is regenerable and must never be committed (main.log in
# particular embeds absolute build paths). Globbed across the series rather than listed per
# paper, so adding a fourth paper cannot quietly start committing its build output.
docs/papers/*/main.pdf
docs/papers/*/main.aux
docs/papers/*/main.bbl
docs/papers/*/main.blg
docs/papers/*/main.log
docs/papers/*/main.out
docs/papers/*/main.toc
# `pdftotext main.pdf` with no output argument writes main.txt beside the paper. Three of
# those appeared untracked while auditing the rendered PDFs, and the extraction is how you
# check what a reader actually sees, so it will happen again.
docs/papers/*/main.txt
# The frozen pre-split draft is provenance and is never built; if it ever acquires a build,
# that is a mistake rather than an artifact to keep. A test asserts these do not exist.
docs/papers/PRE-SPLIT-SOURCE.pdf
docs/papers/PRE-SPLIT-SOURCE.aux
docs/papers/PRE-SPLIT-SOURCE.log
