# WhyStuck local state — NEVER commit captured traces/variants (may contain
# session data even after redaction). Default store is outside the repo, but if
# a user opts into a repo-local store this keeps it out of git.
.whystuck/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/

# mkdocs build output
site/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store
scratchpad/

# LaTeX build artifacts. The paper source is docs/paper/main.tex; everything the
# toolchain derives from it is regenerable and must never be committed (main.log in
# particular embeds absolute build paths).
docs/paper/main.pdf
docs/paper/main.aux
docs/paper/main.bbl
docs/paper/main.blg
docs/paper/main.log
docs/paper/main.out
