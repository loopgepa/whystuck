#!/usr/bin/env bash
# Fast gates, on every commit. The slow one (the full pytest suite) runs in pre-push.
#
# Why the paper check belongs HERE rather than only in a habit: every number in
# docs/papers/*/main.tex is derived from docs/*.json and the committed cassettes, and the two
# have drifted before -- a transposed seed count survived several readings, a $5 ceiling
# claim survived four runs overriding it, and an interval was published as "excludes zero"
# when it brackets it. Those are not typos a reader catches; they are arithmetic that only a
# machine re-derives. So a commit that edits the paper, the results, the cassettes or the
# analysis scripts has to re-derive the paper's claims before it lands.
#
# Install: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PY=.venv/bin/python
[ -x "$PY" ] || PY=python3

echo "pre-commit: ruff check"
$PY -m ruff check .
echo "pre-commit: ruff format --check"
$PY -m ruff format --check .
echo "pre-commit: mypy"
$PY -m mypy

# Only when something the paper's numbers depend on is staged. Scoped rather than
# unconditional because it replays cassettes and takes a few seconds, and a hook that is
# slow on unrelated commits gets disabled -- which is the failure mode that matters.
#
# `docs/papers/` -- plural -- covers all three papers and their shared inputs. It read
# `docs/paper/` until 2026-08-13: the path of the single 46-page draft, deleted when the draft
# was split. So for the whole life of the split tree, a commit editing ONLY paper prose matched
# nothing here and skipped the claim check, while the hook still printed "all green". That is
# the shape of commit that published a PASS rate of 1% against an artifact measuring 0.5%.
# `scripts/paper_sources.py` exists because every other checker had to be migrated off that
# same dead path; this gate was the one left behind, and it is the gate that decides whether
# any of the others run. tests/test_commit_gate_scope.py now pins the pattern against the
# paper paths `paper_sources` reports, so a future move breaks a test instead of a guarantee.
if git diff --cached --name-only | grep -qE '^(docs/papers/|docs/.*\.json$|scripts/|tests/fixtures/cassettes/|src/whystuck/eval/)'; then
  echo "pre-commit: verify_paper_claims (paper vs released artifacts)"
  # grep the verdict rather than tailing: the script ends with a list of what it CANNOT
  # check, so `tail` would print the caveats and hide the result.
  $PY scripts/verify_paper_claims.py | grep -E 'claims match|DRIFT|FAIL'
fi

# Every claim-bearing numeral in the papers must trace to something in docs/, checked against a
# committed baseline of the ones that legitimately cannot (cited results, design constants, prose
# arithmetic). This is the complement to verify_paper_claims above, not a replacement: that gate
# re-derives the numbers it knows about, this one asks whether any number has no backing at all.
# On this tree the baseline holds 302 accepted sites out of 1239, so what it actually catches is a
# NEW unsupported numeral appearing in a paper -- which is what a fabricated or hallucinated
# figure looks like once the tables are already correct.
#
# OPTIONAL BY DESIGN. papyrustrail is a separate project and not every machine has it. A gate that
# breaks commits on a laptop without it would get the whole hook disabled, which costs more than
# it gains. But an optional gate that skips silently is a gate that is never running and nobody
# notices, so absence prints a line rather than nothing.
# Scoped to what papyrustrail actually reads, per papyrustrail.toml: the papers and their
# shared inputs, the released run JSONs, the per-replicate re-scorings, and the config and
# baseline themselves. `^docs/` would have fired on every unrelated doc, and
# tests/test_commit_gate_scope.py rightly failed it.
if git diff --cached --name-only | grep -qE '^(docs/papers/|docs/repeat/|docs/validation-study-.*\.json$|papyrustrail\.toml$|\.papyrustrail/)'; then
  PT=""
  if command -v papyrustrail >/dev/null 2>&1; then
    PT="papyrustrail"
  elif [ -n "${PAPYRUSTRAIL_HOME:-}" ] && [ -x "${PAPYRUSTRAIL_HOME}/.venv/bin/papyrustrail" ]; then
    PT="${PAPYRUSTRAIL_HOME}/.venv/bin/papyrustrail"
  else
    # Third probe, and the one that actually gets this gate running on a developer machine.
    # papyrustrail is a separate private repo (vladimirrott/papyrustrail), so its checkout path
    # differs per clone and cannot be committed here. An environment variable only reaches hooks
    # launched from a shell that exported it, which is why this gate printed NOT RUN for its
    # whole life while the tool sat installed a directory away. `git config` is per-clone, lives
    # in .git/config, and is never committed, so it carries the path without putting a local
    # filesystem layout into the repository:
    #
    #   git config papyrustrail.home /path/to/a/papyrustrail/checkout
    PT_HOME="$(git config --get papyrustrail.home || true)"
    if [ -n "$PT_HOME" ] && [ -x "${PT_HOME}/.venv/bin/papyrustrail" ]; then
      PT="${PT_HOME}/.venv/bin/papyrustrail"
    fi
  fi
  if [ -z "$PT" ]; then
    echo "pre-commit: papyrustrail NOT RUN (not on PATH, PAPYRUSTRAIL_HOME unset or has no venv)"
    echo "  to enable: git config papyrustrail.home /path/to/a/papyrustrail/checkout"
    echo "             (per-clone, uncommitted; or export PAPYRUSTRAIL_HOME to the same path)"
  else
    echo "pre-commit: papyrustrail verify (every paper numeral traces to an artifact)"
    # `verify` exits 1 on a numeral absent from the baseline AND on a baseline entry that no
    # longer occurs, so a stale acceptance fails too rather than rotting. Re-accept deliberately
    # with `papyrustrail accept --repo .` and commit the baseline diff, which is reviewable.
    "$PT" verify --repo . | grep -E 'bind:|restate:|admit:|none|stale' || true
    "$PT" verify --repo . >/dev/null
  fi
fi

# Never let the author's employer name into a personal-project artifact. Checks the staged
# content, not the working tree, so it cannot be bypassed by an unstaged revert.
#
# The pattern is assembled at runtime rather than written out, because a hook that spells the
# forbidden word would match its own diff and refuse the commit that installs it.
FORBIDDEN="$(printf 'entr'; printf 'opia')"
if git diff --cached | grep -iq "$FORBIDDEN"; then
  echo "pre-commit: FAILED -- staged content contains the forbidden employer name" >&2
  exit 1
fi

echo "pre-commit: all green"
